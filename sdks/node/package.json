{
  "name": "@euron/logmind",
  "version": "0.1.0",
  "description": "Node.js SDK for Euron Open LogMind: ship structured log lines to a self-hosted LogMind.",
  "license": "MIT",
  "author": "ENGAGESPHERE TECHNOLOGY PRIVATE LIMITED and the Euron Open LogMind contributors",
  "repository": {
    "type": "git",
    "url": "https://github.com/euron-sde-team/euron-open-logmind.git",
    "directory": "sdks/node"
  },
  "keywords": [
    "logging",
    "logs",
    "observability",
    "log-management",
    "structured-logging",
    "logmind"
  ],
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run test/unit",
    "test:coverage": "vitest run test/unit --coverage",
    "test:integration": "vitest run test/integration",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.7"
  }
}
