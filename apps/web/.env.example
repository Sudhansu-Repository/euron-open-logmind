# Where this server reaches the LogMind API (server side only). Used by the
# authenticated proxy route (/api/proxy), the session bridge, and the build-time rewrites
# for /ws, /healthz, /readyz, /docs and /openapi.json. Next resolves rewrites when it
# builds the standalone server, so set it for `pnpm build` too.
API_URL=http://localhost:6030
# Port for `pnpm dev` and `pnpm start`.
LM_WEB_PORT=6010
# Optional: open the live WebSocket straight against the API (for example
# ws://localhost:6030) when a proxy in front of Next cannot upgrade connections.
NEXT_PUBLIC_WS_URL=
# Optional: force the dashboard session cookie's Secure flag (true|false). Unset, it
# follows the request: Secure over HTTPS (or X-Forwarded-Proto: https), not over plain HTTP.
COOKIE_SECURE=
