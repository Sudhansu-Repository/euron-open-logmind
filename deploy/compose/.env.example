# deploy/compose/.env: generated by `make env` (scripts/gen-local-env.sh) with random
# values. Local only, git-ignored; this file documents every variable it may hold.

# ── Secrets (random, generated) ──────────────────────────────────────────────
# Signs dashboard sessions.
SESSION_SECRET=replace-with-output-of-make-env
# Peppers the hashes of project API keys (lmk_<prefix>_<secret>).
API_KEY_PEPPER=replace-with-output-of-make-env
# Seals AI provider keys and alert channel URLs when KEY_MODE=local (Floci uses KMS).
LOCAL_MASTER_KEY=replace-with-output-of-make-env

# ── Demo ─────────────────────────────────────────────────────────────────────
# The seeded demo logins (make demo); a published demo password, not a secret.
LM_DEMO_PASSWORD=Demo-Owner-Pass-1

# ── Optional behaviour ───────────────────────────────────────────────────────
# LM_LOG_LEVEL=INFO
# How often the worker evaluates alert rules, in seconds.
# LM_ALERT_INTERVAL_S=20
# Mail backend under the Floci overlay: smtp (default, Mailpit at http://localhost:6025)
# or ses (the SES identity Terraform created on the emulator).
# LM_MAIL_BACKEND=smtp

# ── Host ports (all bound to 127.0.0.1; project 20, base 6000) ───────────────
# LM_WEB_PORT=6010
# LM_API_PORT=6030
# LM_PG_PORT=6042
# LM_REDIS_PORT=6079
# LM_CLICKHOUSE_PORT=6023
# LM_MAILPIT_PORT=6025
# LM_SMTP_PORT=6026
# LM_MOCK_AI_PORT=6050
# LM_FLOCI_PORT=6066
