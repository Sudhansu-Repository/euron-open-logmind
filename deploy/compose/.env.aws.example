# deploy/compose/.env.aws: copy to .env.aws (git-ignored) to run `make up-aws`: the local
# containers (postgres, redis, clickhouse, mailpit, web) stay local, but migrate, api and
# worker read these real AWS resource identifiers and call AWS with your AWS CLI profile
# (mounted read-only; AWS_PROFILE below). Get the values from the aws-dev or aws-prod
# Terraform outputs, or your own equivalents.
AWS_PROFILE=default
AWS_REGION=us-east-1

KMS_KEY_ID=alias/acme-logmind-dev
EVIDENCE_BUCKET=acme-logmind-dev-evidence

# Secrets the app otherwise reads from AWS Secrets Manager inside ECS (module.secrets).
SESSION_SECRET=replace-with-a-real-value
API_KEY_PEPPER=replace-with-a-real-value

MAIL_BACKEND=ses
MAIL_FROM=LogMind Alerts <alerts@logmind-dev.example.com>
